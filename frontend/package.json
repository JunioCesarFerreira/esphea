{
  "name": "esphea-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "ESPHEA web interface: configure experiments and explore their results",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "openapi-fetch": "^0.17.0",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
